<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
  </ItemGroup>

  <!-- The frozen Chapter 6 model artifact goes into the build and publish output,
       in a Models folder next to the app. The manifest is next to the model file.
       The policy file lists the feature schema and the Chapter 6 decision rule. -->
  <ItemGroup>
    <None Include="..\..\Models\chapter-06-risk-classifier.zip;..\..\Models\chapter-06-risk-classifier.manifest.json;..\..\Models\chapter-06-risk-classifier.policy.json"
          Link="Models\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RiskClassificationLab\RiskClassificationLab.csproj" />
  </ItemGroup>

  <!-- RiskClassificationLab is a web project. Without this target, its appsettings
       files, its apphost, its runtimeconfig and its web.config flow into our publish
       folder, and its appsettings.json collides with ours (NETSDK1152). The API needs
       only the assembly (and its symbols) of the Chapter 6 project. -->
  <PropertyGroup>
    <LabProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'RiskClassificationLab'))</LabProjectDir>
  </PropertyGroup>
  <Target Name="PublishOnlyLabAssembly" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_LabPublishFile Include="@(ResolvedFileToPublish)"
                       Condition="$([System.String]::new('%(ResolvedFileToPublish.FullPath)').StartsWith('$(LabProjectDir)'))" />
      <_LabKeepFile Include="@(_LabPublishFile)"
                    Condition="'%(_LabPublishFile.Extension)' == '.dll' Or '%(_LabPublishFile.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(_LabPublishFile)" />
      <ResolvedFileToPublish Include="@(_LabKeepFile)" />
    </ItemGroup>
  </Target>

</Project>
